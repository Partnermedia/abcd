#!/usr/bin/env bash
# abcd-name-guard: v1
# abcd private name guard, merge-commit half — scaffolded by `abcd ahoy` beside
# the pre-commit hook.
#
# git does NOT run pre-commit for a merge commit. Without this file every name the
# private layer bans walks into history the moment a branch carrying it is merged,
# and the guard reports nothing, because it was never asked. The same check runs
# here, on the same staged content, with the same output contract: a match refuses
# the merge naming the entry KEY alone.
#
# `git cherry-pick` runs neither hook when it does not stop for an edit, and
# `git rebase`, `git am`, `git commit --no-verify`, and a server-side push bypass
# both by construction. This layer covers the commits git asks a hook about, on
# machines that have opted in — nothing more, and the reach every abcd surface
# states says exactly that.
set -euo pipefail
# The sibling pre-commit hook holds the whole guard: one implementation, so the two
# entry points cannot drift into checking different things. $0 is the path git
# invoked, so this resolves inside whichever hooks directory the clone points at
# (.githooks under `core.hooksPath`, or .git/hooks for a copied install).
guard="$(dirname -- "$0")/pre-commit"
if [ ! -x "$guard" ]; then
  echo "pre-merge-commit: BLOCKED — the name guard at $guard is missing or not executable." >&2
  echo "                  a merge is exactly the commit that bypasses pre-commit, so this refuses" >&2
  echo "                  rather than let it through unchecked. Run \`abcd ahoy install\` to restore it." >&2
  exit 1
fi
exec "$guard" "$@"
