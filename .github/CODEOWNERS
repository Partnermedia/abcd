# The publish surface: paths whose changes ship behaviour to installed users
# (plugin hooks and commands, agent prompts, workflows, gates and their config)
# or alter what the release and site builds produce. The "main review" ruleset
# requires a code-owner review on any pull request touching them; the two
# rulesets are mirrored into .abcd/work/rulesets/ (itd-92 owns the drift check).
/hooks/ @REPPL
/commands/ @REPPL
/agents/ @REPPL
/.claude-plugin/ @REPPL
/.githooks/ @REPPL
/.github/ @REPPL
/scripts/ @REPPL
/Makefile @REPPL
/go.mod @REPPL
/go.sum @REPPL
/.abcd/docs-lint.json @REPPL
/.abcd/record-lint.json @REPPL
/mkdocs.yml @REPPL
/wrangler.jsonc @REPPL
